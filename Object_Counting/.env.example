# Copy this file to .env. Keep camera passwords in .env, not source code.
# stream = RTSP; snapshot = HTTP(S) JPEG endpoint; image = local photo.
SOURCE_KIND=stream
CAMERA_SOURCE="rtsp://username:password@192.168.1.100:554/your-stream-path"

# HTTP snapshot example (endpoint depends on camera manufacturer):
# SOURCE_KIND=snapshot
# CAMERA_SOURCE="http://username:password@192.168.1.100/your-snapshot-endpoint"

# Optional for OpenCV/FFmpeg RTSP transport:
OPENCV_FFMPEG_CAPTURE_OPTIONS="rtsp_transport;tcp"
